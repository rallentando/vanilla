#include <windows.h>
#include <VERSION>

IDI_ICON1               ICON    DISCARDABLE     "vanilla.ico"

// the version the shell shows in the file's properties. both fields come
// from 'VERSION', so the executable cannot drift from the source's version.
VS_VERSION_INFO VERSIONINFO
FILEVERSION     VANILLA_VERSION_RC
PRODUCTVERSION  VANILLA_VERSION_RC
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "rallentando"
            VALUE "FileDescription",  "Vanilla web browser"
            VALUE "FileVersion",      VANILLA_VERSION
            VALUE "InternalName",     "vanilla"
            VALUE "LegalCopyright",   "Copyright (c) 2016, rallentando"
            VALUE "OriginalFilename", "vanilla.exe"
            VALUE "ProductName",      "Vanilla"
            VALUE "ProductVersion",   VANILLA_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
