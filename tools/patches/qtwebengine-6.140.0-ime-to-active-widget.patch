 namespace QtWebEngineCore {
 
+// The widget which the input method talks to: the one whose focused element
+// takes text, which may be an out-of-process iframe's (an extension page shown
+// in a frame, Vimium's Vomnibar). Aura does the same (RenderWidgetHostViewAura
+// ::SetCompositionText). Without it, the root widget is sent the composition,
+// which an out-of-process frame never sees, while the caret rectangle and the
+// input state are taken from the active widget -- so the two disagree.
+static inline content::RenderWidgetHostImpl *imeTarget(RenderWidgetHostViewQt *rwhv)
+{
+    if (auto *manager = rwhv->GetTextInputManager()) {
+        if (auto *widget = manager->GetActiveWidget())
+            return widget;
+    }
+    return rwhv->host();
+}
